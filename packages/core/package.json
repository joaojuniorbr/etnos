{
	"name": "@etnos/core",
	"version": "1.0.0",
	"type": "module",
	"private": true,
	"main": "src/index.js",
	"types": "src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.js"
		}
	},
	"files": ["dist"],
	"scripts": {
		"build": "tsc -p tsconfig.json --noEmit false",
		"check-types": "tsc --noEmit",
		"test": "vitest --coverage --watch=false",
		"test:dev": "vitest --coverage"
	},
	"dependencies": {
		"@etnos/types": "*",
		"axios": "^1.11.0"
	},
	"devDependencies": {
		"@etnos/typescript-config": "*",
		"@vitest/coverage-v8": "^4.0.16",
		"typescript": "5.9.2",
		"vitest": "^4.0.16"
	}
}
