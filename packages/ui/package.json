{
	"name": "@etnos/ui",
	"version": "0.0.0",
	"sideEffects": [
		"**/*.css"
	],
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"import": "./dist/index.js",
			"require": "./dist/index.js",
			"types": "./dist/index.d.ts"
		},
		"./styles.css": "./dist/index.css",
		"./assets/*": "./dist/assets/*"
	},
	"license": "MIT",
	"scripts": {
		"build:styles": "tailwindcss -i ./src/styles.css -o ./dist/index.css",
		"build:components": "tsc",
		"build:assets": "cpx \"src/assets/**\" dist/assets",
		"build": "npm run build:styles && npm run build:components && npm run build:assets",
		"check-types": "tsc --noEmit",
		"dev:styles": "tailwindcss -i ./src/styles.css -o ./dist/index.css --watch",
		"dev:components": "tsc --watch",
		"lint": "eslint src --max-warnings 0",
		"test": "vitest --coverage --watch=false",
		"test:watch": "vitest --watch --coverage",
		"test:ui": "vitest --ui --coverage --open=false"
	},
	"peerDependencies": {
		"react": "^19"
	},
	"devDependencies": {
		"@etnos/eslint-config": "*",
		"@etnos/tailwind-config": "*",
		"@etnos/tools": "*",
		"@etnos/typescript-config": "*",
		"@tailwindcss/cli": "^4.1.5",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^6.6.3",
		"@testing-library/react": "^16.1.0",
		"@types/jest": "^30.0.0",
		"@types/react": "^19.1.0",
		"@vitest/coverage-v8": "^4.0.12",
		"@vitest/ui": "^2.1.4",
		"cpx": "^1.5.0",
		"eslint": "^9.33.0",
		"jsdom": "^26.0.0",
		"tailwindcss": "^4.1.5",
		"typescript": "5.9.2",
		"vitest": "^4.0.12"
	},
	"dependencies": {
		"antd": "^5.27.2",
		"react-icons": "^5.5.0"
	}
}
