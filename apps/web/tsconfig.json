{
	"extends": "@etnos/typescript-config/nextjs.json",
	"compilerOptions": {
		"plugins": [
			{
				"name": "next"
			}
		],
		"baseUrl": ".",
		"paths": {
			"@components": ["./components/index.ts"],
			"@components/*": ["./components/*"],
			"@etnos/common": ["./common"],
			"@etnos/hooks": ["./hooks"]
		}
	},
	"include": [
		"**/*.ts",
		"**/*.tsx",
		"next-env.d.ts",
		"next.config.ts",
		".next/types/**/*.ts"
	],
	"exclude": ["node_modules"]
}
