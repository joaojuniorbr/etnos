{
	"name": "@etnos/games",
	"private": true,
	"version": "0.0.0",
	"sideEffects": [
		"**/*.css"
	],
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"import": "./dist/index.js",
			"require": "./dist/index.js",
			"types": "./dist/index.d.ts"
		},
		"./guess-game": {
			"import": "./dist/games/GuessGame/index.js",
			"require": "./dist/games/GuessGame/index.js",
			"types": "./dist/games/GuessGame/index.d.ts"
		},
		"./memory-game": {
			"import": "./dist/games/MemoryGame/index.js",
			"require": "./dist/games/MemoryGame/index.js",
			"types": "./dist/games/MemoryGame/index.d.ts"
		},
		"./styles.css": "./dist/index.css"
	},
	"scripts": {
		"dev": "yarn run dev:styles & yarn run dev:components",
		"dev:styles": "tailwindcss -i ./src/styles.css -o ./dist/index.css --watch",
		"dev:components": "tsc --watch",
		"lint": "eslint .",
		"test": "vitest --coverage --watch=false",
		"test:dev": "vitest --coverage",
		"build:styles": "tailwindcss -i ./src/styles.css -o ./dist/index.css",
		"build": "yarn run build:styles && yarn run build:components",
		"build:components": "tsc",
		"check-types": "tsc --noEmit"
	},
	"dependencies": {
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"@etnos/types": "*"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.1",
		"@etnos/tools": "*",
		"@etnos/ui": "*",
		"@tailwindcss/postcss": "^4.1.17",
		"@types/node": "^24.10.1",
		"@types/react": "^19.2.5",
		"@types/react-dom": "^19.2.3",
		"@vitest/coverage-v8": "^4.0.16",
		"@vitejs/plugin-react": "^5.1.1",
		"autoprefixer": "^10.4.22",
		"eslint": "^9.39.1",
		"eslint-plugin-react-hooks": "^7.0.1",
		"eslint-plugin-react-refresh": "^0.4.24",
		"globals": "^16.5.0",
		"postcss": "^8.5.6",
		"tailwindcss": "^4.1.17",
		"typescript": "~5.9.3",
		"typescript-eslint": "^8.46.4",
		"vite": "^7.2.4",
		"vitest": "^4.0.16"
	}
}
