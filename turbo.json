{
	"$schema": "https://turborepo.com/schema.json",
	"ui": "tui",
	"tasks": {
		"build": {
			"dependsOn": ["^build", "build:components", "build:styles"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": [
				"dist/**",
				"out/**",
				".next/**",
				"!.next/cache/**",
				"storybook-static/**"
			]
		},
		"build:components": {
			"dependsOn": ["^build:components"],
			"outputs": ["dist/**"]
		},
		"build:styles": {
			"dependsOn": ["^build:styles"],
			"outputs": ["dist/**"]
		},
		"lint": {
			"dependsOn": ["^lint"]
		},
		"check-types": {
			"dependsOn": ["^check-types"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"test": {
			"dependsOn": ["^test"],
			"outputs": ["coverage/**"]
		}
	}
}
