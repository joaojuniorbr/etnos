generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                   String          @id @default(cuid())
  firebaseUid          String          @unique @map("firebase_uid")
  email                String?         @db.VarChar(255)
  parentName           String?         @map("parent_name") @db.VarChar(255)
  childName            String?         @map("child_name") @db.VarChar(255)
  childBirthDate       String?         @map("child_birth_date") @db.VarChar(50)
  parentPhone          String?         @map("parent_phone") @db.VarChar(50)
  school               String?         @db.VarChar(255)
  photoURL             String?         @map("photo_url")
  avatarCharacterSlug  String?         @map("avatar_character_slug") @db.VarChar(255)
  roles                String[]        @default(["student"])
  isActive             Boolean         @default(true) @map("is_active")
  notificationsEnabled Boolean         @default(true) @map("notifications_enabled")
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")
  schoolAccesses       SchoolAccess[]
  pushTokens           UserPushToken[]

  @@index([school], map: "users_school_idx")
  @@index([notificationsEnabled], map: "users_notifications_enabled_idx")
  @@map("users")
}

model School {
  id                String                   @id @default(cuid())
  name              String                   @unique @db.VarChar(255)
  code              String?                  @unique @db.VarChar(100)
  city              String?                  @db.VarChar(255)
  state             String?                  @db.VarChar(255)
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")
  userAccesses      SchoolAccess[]
  enabledGames      SchoolEnabledGame[]
  enabledCharacters SchoolEnabledCharacter[]

  @@map("schools")
}

model SchoolAccess {
  id        String   @id @default(cuid())
  schoolId  String   @map("school_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([schoolId, userId], map: "school_accesses_school_id_user_id_key")
  @@index([schoolId], map: "school_accesses_school_id_idx")
  @@index([userId], map: "school_accesses_user_id_idx")
  @@map("school_accesses")
}

model Character {
  id               String                   @id @default(cuid())
  name             String                   @db.VarChar(255)
  region           String                   @db.VarChar(255)
  description      String
  slug             String                   @unique @db.VarChar(255)
  imageUrl         String?                  @map("image_url")
  createdAt        DateTime                 @default(now()) @map("created_at")
  updatedAt        DateTime                 @updatedAt @map("updated_at")
  gameConfigs      GameConfig[]
  enabledBySchools SchoolEnabledCharacter[]

  @@map("characters")
}

model SchoolEnabledGame {
  id        String   @id @default(cuid())
  schoolId  String   @map("school_id")
  gameSlug  String   @map("game_slug") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([schoolId, gameSlug], map: "school_enabled_games_school_id_game_slug_key")
  @@index([schoolId], map: "school_enabled_games_school_id_idx")
  @@index([gameSlug], map: "school_enabled_games_game_slug_idx")
  @@map("school_enabled_games")
}

model SchoolEnabledCharacter {
  id            String    @id @default(cuid())
  schoolId      String    @map("school_id")
  characterSlug String    @map("character_slug") @db.VarChar(255)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  school        School    @relation(fields: [schoolId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  character     Character @relation(fields: [characterSlug], references: [slug], onDelete: Restrict, onUpdate: Cascade)

  @@unique([schoolId, characterSlug], map: "school_enabled_characters_school_id_character_slug_key")
  @@index([schoolId], map: "school_enabled_characters_school_id_idx")
  @@index([characterSlug], map: "school_enabled_characters_character_slug_idx")
  @@map("school_enabled_characters")
}

model GameConfig {
  id            String    @id @default(cuid())
  gameSlug      String    @map("game_slug") @db.VarChar(255)
  characterSlug String    @map("character_slug") @db.VarChar(255)
  imageCoverUrl String    @map("image_cover_url")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  character     Character @relation(fields: [characterSlug], references: [slug], onDelete: Restrict, onUpdate: Cascade)

  @@unique([gameSlug, characterSlug], map: "game_configs_game_slug_character_slug_key")
  @@index([gameSlug], map: "game_configs_game_slug_idx")
  @@map("game_configs")
}

model MemoryGameContent {
  id          String   @id @default(cuid())
  url         String
  slug        String   @db.VarChar(255)
  characterId String   @map("character_id") @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([slug], map: "memory_game_contents_slug_idx")
  @@index([characterId], map: "memory_game_contents_character_id_idx")
  @@map("memory_game_contents")
}

model GuessGameContent {
  id            String   @id @default(cuid())
  title         String   @db.VarChar(255)
  word          String   @db.VarChar(255)
  tips          String[]
  imageUrl      String?  @map("image_url")
  description   String
  characterSlug String   @map("character_slug") @db.VarChar(255)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([characterSlug], map: "guess_game_contents_character_slug_idx")
  @@map("guess_game_contents")
}

model GameScore {
  id            String   @id @default(cuid())
  slug          String   @db.VarChar(255)
  characterSlug String   @map("character_slug") @db.VarChar(255)
  score         Int
  userId        String   @map("user_id") @db.VarChar(255)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([slug, characterSlug, userId], map: "game_scores_slug_character_slug_user_id_key")
  @@index([userId], map: "game_scores_user_id_idx")
  @@index([slug, characterSlug], map: "game_scores_slug_character_slug_idx")
  @@map("game_scores")
}

model GameScoreHistory {
  id            String    @id @default(cuid())
  gameSlug      String    @map("game_slug") @db.VarChar(255)
  characterSlug String    @map("character_slug") @db.VarChar(255)
  score         Int
  userId        String    @map("user_id") @db.VarChar(255)
  schoolId      String?   @map("school_id") @db.VarChar(255)
  startedAt     DateTime  @default(now()) @map("started_at")
  endedAt       DateTime? @map("ended_at")
  status        String    @default("completed") @db.VarChar(32)
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([userId], map: "game_score_histories_user_id_idx")
  @@index([schoolId], map: "game_score_histories_school_id_idx")
  @@index([gameSlug], map: "game_score_histories_game_slug_idx")
  @@index([userId, status], map: "game_score_histories_user_id_status_idx")
  @@index([userId, gameSlug, startedAt(sort: Desc)], map: "game_score_histories_user_game_started_at_idx")
  @@index([userId, schoolId, startedAt(sort: Desc)], map: "game_score_histories_user_school_started_at_idx")
  @@map("game_score_histories")
}

model GameNpsResponse {
  id            String   @id @default(cuid())
  rating        Int
  comment       String?  @db.Text
  userId        String   @map("user_id") @db.VarChar(255)
  characterSlug String   @map("character_slug") @db.VarChar(255)
  gameSlug      String   @map("game_slug") @db.VarChar(255)
  schoolId      String?  @map("school_id") @db.VarChar(255)
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([userId], map: "game_nps_responses_user_id_idx")
  @@index([schoolId], map: "game_nps_responses_school_id_idx")
  @@index([gameSlug], map: "game_nps_responses_game_slug_idx")
  @@index([createdAt], map: "game_nps_responses_created_at_idx")
  @@map("game_nps_responses")
}

model Midia {
  id        String   @id @default(cuid())
  url       String
  folder    String?  @db.VarChar(255)
  path      String?  @db.VarChar(500)
  userId    String   @map("user_id") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId], map: "midia_user_id_idx")
  @@index([folder], map: "midia_folder_idx")
  @@index([userId, folder], map: "midia_user_id_folder_idx")
  @@index([userId, createdAt(sort: Desc)], map: "midia_user_id_created_at_idx")
  @@map("midia")
}

model UserPushToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @unique
  platform  String?  @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "user_push_tokens_user_id_idx")
  @@map("user_push_tokens")
}

model NotificationTemplate {
  id        String   @id @default(cuid())
  title     String   @db.VarChar(255)
  message   String
  createdBy String   @map("created_by") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("notification_templates")
}

model NotificationLog {
  id          String   @id @default(cuid())
  title       String   @db.VarChar(255)
  message     String
  targetType  String   @map("target_type") @db.VarChar(50)
  schoolId    String?  @map("school_id") @db.VarChar(255)
  schoolName  String?  @map("school_name") @db.VarChar(255)
  sentBy      String   @map("sent_by") @db.VarChar(255)
  sentByEmail String?  @map("sent_by_email") @db.VarChar(255)
  sentAt      DateTime @default(now()) @map("sent_at")
  tokenCount  Int      @default(0) @map("token_count")

  @@index([sentAt(sort: Desc)], map: "notification_logs_sent_at_idx")
  @@index([schoolId], map: "notification_logs_school_id_idx")
  @@map("notification_logs")
}
