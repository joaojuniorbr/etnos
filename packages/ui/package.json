{
	"name": "@etnos/ui",
	"version": "0.0.0",
	"sideEffects": [
		"**/*.css"
	],
	"files": [
		"dist"
	],
	"main": "src/index.ts",
	"types": "src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts",
			"require": "./src/index.ts"
		},
		"./styles.css": "./dist/index.css",
		"./assets/*": "./dist/assets/*"
	},
	"license": "MIT",
	"scripts": {
		"build:styles": "tailwindcss -i ./src/styles.css -o ./dist/index.css",
		"build:components": "tsc -p tsconfig.build.json",
		"build:assets": "cpx \"src/assets/**\" dist/assets",
		"build": "yarn run build:styles && yarn run build:components && yarn run build:assets",
		"check-types": "tsc --noEmit",
		"dev:styles": "tailwindcss -i ./src/styles.css -o ./dist/index.css --watch",
		"dev:components": "tsc --watch",
		"lint": "eslint src --max-warnings 0",
		"test": "vitest --coverage --watch=false",
		"test:dev": "vitest --watch --coverage",
		"test:ui": "vitest --ui --coverage",
		"storybook": "yarn --cwd ../../apps/docs dev",
		"storybook:build": "yarn --cwd ../../apps/docs build-storybook"
	},
	"devDependencies": {
		"@etnos/eslint-config": "*",
		"@etnos/tailwind-config": "*",
		"@etnos/tools": "*",
		"@etnos/typescript-config": "*",
		"@tailwindcss/cli": "^4.1.5",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^6.6.3",
		"@testing-library/react": "^16.1.0",
		"@types/jest": "^30.0.0",
		"@types/react": "^19.1.0",
		"@types/react-dom": "^19.1.1",
		"@vitest/coverage-v8": "^4.0.16",
		"@vitest/ui": "^4.0.16",
		"cpx": "^1.5.0",
		"eslint": "^9.33.0",
		"jsdom": "^26.0.0",
		"tailwindcss": "^4.1.5",
		"typescript": "5.9.2",
		"vitest": "^4.0.16"
	},
	"dependencies": {
		"@ant-design/icons": "^6.1.0",
		"@etnos/analytics": "*",
		"@etnos/services": "*",
		"@etnos/types": "*",
		"@etnos/tools": "*",
		"@tanstack/react-query": "^5.87.1",
		"@tanstack/react-query-devtools": "^5.91.3",
		"antd": "^6.1.0",
		"react-icons": "^5.5.0"
	}
}
